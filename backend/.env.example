# Copy to backend/.env for local development (backend/.env is gitignored).
# In Azure, set these as App Settings / Key Vault references instead.

# "dev" allows a short admin password (local testing only). Leave unset in Azure:
# the server then refuses to start if the admin password is shorter than 12 characters.
GLYIMPSE_ENV=

# Admin-only login: this account is created (or its password reset) at startup.
GLYIMPSE_ADMIN_USERNAME=change-me
GLYIMPSE_ADMIN_PASSWORD=at-least-12-characters

# Dev only: demo accounts patient<id> preloaded from backend/data/<recording>.xlsx.
# Comma-separated recording:password entries; entries without ":password" use GLYIMPSE_SEED_PASSWORD.
# Existing histories are never overwritten; a changed password re-keys the account.
# GLYIMPSE_SEED_RECORDINGS=2072_0_20210706:first-password,2064_0_20210608:second-password
# GLYIMPSE_SEED_PASSWORD=
# GLYIMPSE_DATA_DIR=backend/data

# Public sign-up via POST /accounts stays off unless this is true.
GLYIMPSE_ALLOW_SIGNUP=false

# Comma-separated browser origins allowed to call the API. "*" is for local dev only.
# Example: https://<your-static-web-app>.azurestaticapps.net
GLYIMPSE_ALLOWED_ORIGINS=*

# Optional overrides
# GLYIMPSE_STATE_DIR=backend/runtime
# GLYIMPSE_MODEL_PATH=backend/artifacts/population.joblib
# GLYIMPSE_FRONTEND_DIR=frontend      (empty value = API only, don't serve the frontend)
# GLYIMPSE_EVALUATION_PATH=output_v.1/day8_actual_vs_predicted.csv   (Profile -> Model accuracy)
