# Copy to .env and fill in. Never commit the real .env.

# LLM: set ONE of these. With only a Google key, Gemini is used automatically.
GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Optional LLM settings
# LLM_PROVIDER=gemini            # or openai (auto-detected from the keys above)
# LLM_MODEL=gemini-2.5-flash     # default gemini-2.5-flash (Gemini) / gpt-4.1-mini (OpenAI)
# LLM_REQUESTS_PER_MINUTE=8      # Gemini default 8 (free tier allows ~10); raise on a paid tier
# LLM_REASONING_EFFORT=none      # Gemini 2.5 Flash: disable "thinking" to cut latency and cost
# LLM_TEMPERATURE=0

# Free key: https://fdc.nal.usda.gov/api-key-signup  (DEMO_KEY is used if empty, ~30 requests/hour)
USDA_API_KEY=
# USDA_REQUESTS_PER_HOUR=900

# Optional overrides
# BATCH_SIZE=25
# FALLBACK_BATCH_SIZE=25
# SNAPSHOT_EVERY=5               # take a save state every N checkpoint writes
# SNAPSHOT_MIN_INTERVAL_S=120    # at most one periodic save state per this many seconds
# SNAPSHOT_KEEP=30               # number of save states kept per cache
# USD per 1M tokens; defaults come from MODEL_PRICES in src/config.py
# MODEL_INPUT_COST_PER_MILLION=0.30
# MODEL_OUTPUT_COST_PER_MILLION=2.50
